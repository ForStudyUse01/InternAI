# Copy to .env and fill in real values. Never commit the real .env file.

# --- Required ---
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/internai
JWT_SECRET=change-me

# --- Recommended in production ---
CLIENT_URL=http://localhost:3000
JWT_REFRESH_SECRET=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000

# --- Optional feature flags ---
AUTO_SEED=true
ENABLE_AI=true
ENABLE_CHAT=true
ENABLE_INTERVIEW_ROOMS=true
ENABLE_3D_PORTFOLIO=true
ENABLE_NOTIFICATIONS=true
ENABLE_RECORDINGS=true
ALLOW_VERCEL_PREVIEW=false

# --- Optional: Redis / Upstash cache (falls back to in-memory cache if unset) ---
REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_DEFAULT_TTL_SECONDS=3600

# --- Optional: Neon/Postgres analytics store (skipped entirely if unset) ---
DATABASE_URL=

# --- Optional: file storage (defaults to local disk under /uploads) ---
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=internai

# --- Optional: AI providers (falls back to local heuristics if unset) ---
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# --- Optional: outbound email (OTP/notifications) ---
SMTP_USER=
SMTP_FROM=

# --- Optional: deployment metadata (informational only) ---
DEPLOY_TARGET=render
DEPLOY_REGION=auto
